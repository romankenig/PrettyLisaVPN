# Select explicitly; the legacy default remains PRETTYLISA_V1.
# This file is an example, not automatically loaded by the executable.
PRETTYLISA_OBFUSCATION_MODE=SIMPLE_PACKET_WRAPPER_V1
PRETTYLISA_OBFUSCATION_VERSION=1
# Maximum OUTER UDP payload; add 28 bytes for IPv4+UDP on the wire.
PRETTYLISA_MAX_DATAGRAM_SIZE=1400
PRETTYLISA_OBFUSCATION_BIND_HOST=0.0.0.0
PRETTYLISA_OBFUSCATION_BIND_PORT=443
PRETTYLISA_WIREGUARD_HOST=127.0.0.1
PRETTYLISA_WIREGUARD_PORT=51820
# No shared secret for SIMPLE_PACKET_WRAPPER_V1 or NONE.
# PRETTYLISA_OBFUSCATION_SECRET is required only by the legacy PRETTYLISA_V1 mode.
