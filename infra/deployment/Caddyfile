{
	email {$ACME_EMAIL}
	admin off
}

# Public payment return URLs are separate from the private monitoring site.
prettylisavpn.com {
	encode zstd gzip
	handle /1plat.txt {
		root * /etc/caddy/merchant-verification
		header Cache-Control "no-store"
		file_server
	}
	@payment path /payment/success /payment/failure /payment/assets/style.css /payment/assets/logo.svg /api/payments/1plat/callback /support /support/
	handle @payment {
		request_body {
			max_size 64KB
		}
		reverse_proxy backend:8000
	}
	handle {
		respond "Not found" 404
	}
	# No access log: payment return query strings may contain provider identifiers.
}

{$API_DOMAIN} {
	encode zstd gzip

	# Optional owner-managed password-protected monitoring site.
	import /etc/caddy/dashboard/*.caddy

	@support path /support/requests
	request_body @support {
		max_size 11MB
	}

	reverse_proxy backend:8000 {
		health_uri /health
		health_interval 30s
		health_timeout 3s
	}

	log {
		output stdout
		format json
	}
}
