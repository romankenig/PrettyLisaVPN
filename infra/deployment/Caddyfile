{
	email {$ACME_EMAIL}
	admin off
}

# Public website and client files are separate from private monitoring.
prettylisavpn.com {
	encode zstd gzip
	# Only authenticated browser egress probes use this second hostname.
	# The extension keeps the API control plane reachable outside its proxy.
	@browser_probe {
		method GET
		path_regexp browser_probe ^/vpn/sessions/[0-9a-fA-F-]{36}/probe$
	}
	handle @browser_probe {
		header Cache-Control "no-store"
		reverse_proxy backend:8000
	}
	@billing_web path /api/web/billing/*
	handle @billing_web {
		request_body {
			max_size 8KB
		}
		header Cache-Control "no-store"
		reverse_proxy backend:8000
	}
	@public_billing_catalog {
		method GET
		path /api/billing/catalog
	}
	handle @public_billing_catalog {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}
	handle /api/payments/cardlink/callback {
		request_body {
			max_size 16KB
		}
		reverse_proxy backend:8000
	}
	handle /api/payments/platega/callback {
		request_body {
			max_size 16KB
		}
		header Cache-Control "no-store"
		reverse_proxy backend:8000
	}
	@payment path /payment/success /payment/failure /payment/assets/style.css /payment/assets/logo.svg
	handle @payment {
		request_body {
			max_size 64KB
		}
		reverse_proxy backend:8000
	}
	@checkout_post {
		method POST
		path /checkout /checkout/
	}
	handle @checkout_post {
		header Content-Type application/json
		respond `{"error":{"code":"WEB_CHECKOUT_DISABLED"}}` 503
	}
	# Only verified publisher outputs are public. Never expose the dashboard directory.
	@client_downloads {
		method GET HEAD
		path /downloads/android.apk /downloads/windows.exe /downloads/android-sources.tar.gz /downloads/windows-sources.tar.gz /downloads/windows-licenses.txt /downloads/index.json
	}
	handle @client_downloads {
		uri strip_prefix /downloads
		root * /srv/client-downloads/current
		header {
			Cache-Control "no-store"
			X-Content-Type-Options "nosniff"
			X-Robots-Tag "noindex, nofollow"
		}
		@binary path /downloads/android.apk /downloads/windows.exe /downloads/android-sources.tar.gz /downloads/windows-sources.tar.gz
		header @binary Content-Disposition "attachment"
		file_server
	}
	@old_support path /support /support/
	redir @old_support /#help 308
	@old_setup path /setup /setup/
	redir @old_setup /#download 308
	@website {
		method GET HEAD
		path / /account /account/* /en /en/* /de /de/* /fr /fr/* /es /es/* /zh /zh/* /download /download/* /legal /legal/* /404 /404/* /assets/* /robots.txt /build-identity.json /shop-verification-xO2ZZeK02A.txt
	}
	handle @website {
		root * /srv/public-website/current
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
		file_server
	}
	handle {
		respond "Not found" 404
	}
	# No access log: payment return query strings may contain provider identifiers.
}

{$API_DOMAIN} {
	encode zstd gzip

	# Optional owner-managed password-protected monitoring site.
	import /etc/caddy/dashboard/*.caddy

	@support path /support/requests
	request_body @support {
		max_size 11MB
	}

	reverse_proxy backend:8000 {
		health_uri /health
		health_interval 30s
		health_timeout 3s
	}

	log {
		output stdout
		format json
	}
}
