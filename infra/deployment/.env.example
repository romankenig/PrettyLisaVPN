# Copy to /etc/prettylisavpn/deployment.env, replace every REPLACE_* value,
# set owner root:root and mode 0600, and never commit the resulting file.

API_DOMAIN=api.example.invalid
ACME_EMAIL=ops@example.invalid

# Prefer an immutable registry digest. A unique release tag is also supported.
BACKEND_IMAGE=registry.example.invalid/prettylisavpn/backend@sha256:REPLACE_IMAGE_DIGEST
APPLICATION_NAME=PrettyLisaVPN
APPLICATION_VERSION=REPLACE_RELEASE_VERSION
ENVIRONMENT=production
LOG_LEVEL=INFO

# These URLs are secrets because they contain credentials. Percent-encode reserved
# characters in usernames and passwords. Preserve provider-required TLS options.
POSTGRES_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@postgres.example.invalid:5432/REPLACE_DATABASE
VALKEY_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@valkey.example.invalid:6379/0

DEPENDENCY_TIMEOUT_SECONDS=2
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5

# Usually leave these at their public defaults. Alternate ports are useful only
# for local validation; public ACME validation normally requires ports 80 and 443.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
