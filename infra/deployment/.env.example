# Скопируйте в /etc/prettylisavpn/deployment.env, замените REPLACE_* и example.invalid.
# Установите владельца root:root и права 0600; не коммитьте заполненный файл.

API_DOMAIN=api.example.invalid
ACME_EMAIL=ops@example.invalid

# Предпочтителен неизменяемый digest образа; допускается уникальный тег релиза.
BACKEND_IMAGE=registry.example.invalid/prettylisavpn/backend@sha256:REPLACE_IMAGE_DIGEST
APPLICATION_NAME=PrettyLisaVPN
APPLICATION_VERSION=REPLACE_RELEASE_VERSION
ENVIRONMENT=production
LOG_LEVEL=INFO

# URL содержат секреты. Кодируйте специальные символы логина и пароля для URL.
# Сохраняйте параметры TLS, которые требует провайдер баз данных.
POSTGRES_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@postgres.example.invalid:5432/REPLACE_DATABASE
VALKEY_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@valkey.example.invalid:6379/0
OTP_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OTP_TTL_SECONDS=300
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_EMAIL_REQUEST_LIMIT=5
OTP_EMAIL_RATE_WINDOW_SECONDS=3600
OTP_IP_REQUEST_LIMIT=20
OTP_IP_RATE_WINDOW_SECONDS=3600
OTP_MAX_VERIFICATION_ATTEMPTS=5
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# SMTP credential is the mailbox password; keep it only in the protected env file.
EMAIL_PROVIDER=timeweb
EMAIL_SMTP_HOST=smtp.timeweb.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_TLS_MODE=implicit_tls
EMAIL_SMTP_USERNAME=auth@prettylisavpn.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=auth@prettylisavpn.com
EMAIL_FROM_NAME=PrettyLisaVPN
EMAIL_CONNECTION_TIMEOUT_SECONDS=5
EMAIL_SEND_TIMEOUT_SECONDS=10

DEPENDENCY_TIMEOUT_SECONDS=2
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5

# Enable authenticated VPN-node health polling only after mounting these files read-only
# into the Backend container. All four credential settings are atomic.

# Обычно оставляйте стандартные публичные адреса и порты.
# Для публичной проверки домена при выпуске сертификата нужны порты 80 и 443.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443


# Separate Timeweb mailbox app-helper@prettylisavpn.com; recipient fixed to help@prettylisavpn.com.
SUPPORT_SMTP_PASSWORD=
