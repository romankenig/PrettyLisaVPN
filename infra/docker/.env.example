# Production template only. Supply real values through your deployment environment
# or an untracked --env-file; never use build arguments for credentials.
BACKEND_IMAGE=prettylisavpn-backend:0.1.0
APPLICATION_VERSION=0.1.0
POSTGRES_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@postgres.example.invalid:5432/prettylisa
VALKEY_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@valkey.example.invalid:6379/0
BACKEND_PORT=8000
APPLICATION_NAME=PrettyLisaVPN
LOG_LEVEL=INFO
DEPENDENCY_TIMEOUT_SECONDS=2
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
