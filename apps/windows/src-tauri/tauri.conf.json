{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrettyLisaVPN",
  "version": "0.24.1",
  "identifier": "com.prettylisavpn.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrettyLisaVPN",
        "width": 960,
        "height": 640,
        "minWidth": 960,
        "minHeight": 640,
        "maxWidth": 960,
        "maxHeight": 640,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https: http://127.0.0.1:8000"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "windows/key-licenses.txt": "licenses/key-licenses.txt",
      "engine/Wintun-Prebuilt-License.txt": "licenses/Wintun-Prebuilt-License.txt"
    }
  }
}
