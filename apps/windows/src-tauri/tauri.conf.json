{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrettyLisaVPN",
  "version": "0.1.0",
  "identifier": "com.prettylisavpn.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrettyLisaVPN",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https: http://127.0.0.1:8000"
    }
  },
  "bundle": {
    "active": false
  }
}
