VITE_APP_ENVIRONMENT=development
VITE_BACKEND_BASE_URL=https://api.prettylisavpn.com
VITE_BACKEND_TIMEOUT_MS=15000
VITE_BACKEND_HEALTH_INTERVAL_MS=15000

# Native process settings: set in PowerShell before pnpm tauri dev (not VITE_*).
# PRETTYLISA_VPN_TRANSPORT_MODE=WG_OBFUSCATOR
# PRETTYLISA_WG_OBFUSCATOR_EXE=C:\absolute\protected-components\wg-obfuscator.exe
# PRETTYLISA_WG_OBFUSCATOR_KEY_FILE=C:\absolute\protected-config\key.conf
# PRETTYLISA_WG_OBFUSCATOR_PORT=443
# PRETTYLISA_WG_OBFUSCATOR_MASKING=NONE

# Native process setting. JSON; 1-4 HTTPS endpoints, expected status plus body/IP.
# Optional expected_egress_ip is the node's public NAT egress, not its tunnel IP.
# PRETTYLISA_HEALTH_CONFIG={"endpoints":[{"url":"https://health.example.com/vpn","expected_status":200,"expected_body":"ok"},{"url":"https://egress.example.com/ip","expected_status":200,"public_ip_body":true}]}
