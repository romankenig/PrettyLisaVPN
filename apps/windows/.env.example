VITE_APP_ENVIRONMENT=development
VITE_BACKEND_BASE_URL=https://api.prettylisavpn.com
VITE_BACKEND_TIMEOUT_MS=15000
VITE_BACKEND_HEALTH_INTERVAL_MS=15000

