redir /dashboard /dashboard/ 308
handle /dashboard/* {
    route {
        basic_auth bcrypt PrettyLisaVPN {
            @@USERNAME@@ @@PASSWORD_HASH@@
        }
        header {
            Cache-Control "private, no-store"
            X-Content-Type-Options nosniff
            Referrer-Policy no-referrer
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
        }
        @availability {
            path /dashboard/api/availability
            method GET
        }
        handle @availability {
            rewrite * /admin/monitoring/availability?days=7
            reverse_proxy backend:8000 {
                header_up Authorization "Bearer @@MONITOR_TOKEN@@"
            }
        }
        @analytics {
            path /dashboard/api/product-analytics
            method GET
        }
        handle @analytics {
            rewrite * /admin/monitoring/product-analytics
            reverse_proxy backend:8000 {
                header_up Authorization "Bearer @@MONITOR_TOKEN@@"
            }
        }
        @analytics_page path /dashboard/product-analytics /dashboard/product-analytics/
        handle @analytics_page {
            rewrite * /index.html
            root * /etc/caddy/dashboard/site
            file_server
        }
        handle_path /dashboard/downloads/* {
            root * /etc/caddy/dashboard/downloads/current
            @binary path /android.apk /windows.exe /chrome-extension.zip /ios-unsigned.zip /ios-simulator.zip /macos-unsigned.zip /android-sources.tar.gz /windows-sources.tar.gz /ios-sources.tar.gz /macos-sources.tar.gz /windows-licenses.txt
            header @binary Content-Disposition attachment
            file_server
        }
        handle {
            uri strip_prefix /dashboard
            root * /etc/caddy/dashboard/site
            file_server
        }
    }
}
