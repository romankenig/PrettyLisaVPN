APPLICATION_NAME=PrettyLisaVPN
APPLICATION_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Local-only example credentials; replace for any shared environment.
POSTGRES_URL=postgresql+asyncpg://prettylisa:local-development-only@localhost:5432/prettylisa
VALKEY_URL=redis://localhost:6379/0
DEPENDENCY_TIMEOUT_SECONDS=2
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
