# Только для локальной разработки с infra/docker/compose.yaml.
# Скопируйте в .env; не коммитьте файл с настоящими паролями.
APPLICATION_NAME=PrettyLisaVPN
APPLICATION_VERSION=0.40.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Stable independent key: do not rotate casually; rotation changes device quota identity.
DEMO_ENABLED=false
# DEMO_IDENTITY_SECRET=replace-with-at-least-32-random-characters

# Backend читает готовые URL, а не отдельные HOST/USER/PASSWORD.
# Если порт базы на компьютере изменён, исправьте его и здесь.
POSTGRES_URL=postgresql+asyncpg://prettylisa:local-development-only@127.0.0.1:5432/prettylisa
VALKEY_URL=redis://127.0.0.1:6379/0

# Минимум 32 случайных символа. Для production создайте отдельный секрет.
OTP_HMAC_SECRET=local-development-otp-hmac-secret-change-me
OTP_TTL_SECONDS=300
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_EMAIL_REQUEST_LIMIT=5
OTP_EMAIL_RATE_WINDOW_SECONDS=3600
OTP_IP_REQUEST_LIMIT=20
OTP_IP_RATE_WINDOW_SECONDS=3600
OTP_MAX_VERIFICATION_ATTEMPTS=5
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Timeweb mailbox delivery. Leave the credential empty in committed examples.
EMAIL_PROVIDER=timeweb
EMAIL_SMTP_HOST=smtp.timeweb.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_TLS_MODE=implicit_tls
EMAIL_SMTP_USERNAME=auth@prettylisavpn.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=auth@prettylisavpn.com
EMAIL_FROM_NAME=PrettyLisaVPN
EMAIL_CONNECTION_TIMEOUT_SECONDS=5
EMAIL_SEND_TIMEOUT_SECONDS=10

DEPENDENCY_TIMEOUT_SECONDS=2
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5



# Separate Timeweb mailbox app-helper@prettylisavpn.com; recipient fixed to help@prettylisavpn.com.
SUPPORT_SMTP_PASSWORD=


# sandbox is restricted to isolated development/test. platega needs real server credentials.
# Notifications: python -m prettylisavpn.billing.sandbox OPERATION_UUID SUCCEEDED --event-id EVENT_UUID
BILLING_PROVIDER=disabled
# Optional Result URL verification only; does not enable checkout or recurring charges.
# Omit until Cardlink issues the API integration token after project creation.
# CARDLINK_API_TOKEN=replace-with-secret-api-token

# Optional fleet control plane; keep disabled until both scoped secrets are supplied.
FLEET_ENABLED=false
# Requires fleet-worker and customer lease capable node helpers.
CLIENT_VPN_ENABLED=false
# Separate native-engine admission; retain the key until all its leases are closed.
MANAGED_VPN_ENABLED=false
# MANAGED_VPN_SECRET=<independent-at-least-32-random-characters>
# FLEET_ADMIN_TOKEN=<at-least-32-random-characters>
# FLEET_MONITOR_TOKEN=<different-at-least-32-random-characters>
FLEET_SPEED_TARGET_MBPS=30
FLEET_CONNECTION_TARGET_MS=1000
FLEET_QUALITY_WEIGHTS=[0.50,0.20,0.15,0.15]

# Platega: оставьте disabled до получения Merchant ID и X-Secret.
# Нулевой UUID — заглушка, включение оплаты с ней запрещено.
PLATEGA_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# PLATEGA_SECRET=replace-with-real-server-only-merchant-secret

# Activity threshold, bits/second per account and direction, after merging selected nodes.
FLEET_ACTIVITY_THRESHOLD_BPS=10000
