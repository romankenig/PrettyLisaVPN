# Только для локальной разработки с infra/docker/compose.yaml.
# Скопируйте в .env; не коммитьте файл с настоящими паролями.
APPLICATION_NAME=PrettyLisaVPN
APPLICATION_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend читает готовые URL, а не отдельные HOST/USER/PASSWORD.
# Если порт базы на компьютере изменён, исправьте его и здесь.
POSTGRES_URL=postgresql+asyncpg://prettylisa:local-development-only@127.0.0.1:5432/prettylisa
VALKEY_URL=redis://127.0.0.1:6379/0

# Минимум 32 случайных символа. Для production создайте отдельный секрет.
OTP_HMAC_SECRET=local-development-otp-hmac-secret-change-me
OTP_TTL_SECONDS=300
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_EMAIL_REQUEST_LIMIT=5
OTP_EMAIL_RATE_WINDOW_SECONDS=3600
OTP_IP_REQUEST_LIMIT=20
OTP_IP_RATE_WINDOW_SECONDS=3600
OTP_MAX_VERIFICATION_ATTEMPTS=5
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Timeweb mailbox delivery. Leave the credential empty in committed examples.
EMAIL_PROVIDER=timeweb
EMAIL_SMTP_HOST=smtp.timeweb.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_TLS_MODE=implicit_tls
EMAIL_SMTP_USERNAME=auth@prettylisavpn.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=auth@prettylisavpn.com
EMAIL_FROM_NAME=PrettyLisaVPN
EMAIL_CONNECTION_TIMEOUT_SECONDS=5
EMAIL_SEND_TIMEOUT_SECONDS=10

DEPENDENCY_TIMEOUT_SECONDS=2
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
